# PostgreSQL (async API)
DATABASE_URL=postgresql+asyncpg://atlas:atlas@127.0.0.1:5432/atlas

# PostgreSQL (sync Celery workers — used by Alembic too)
CELERY_DATABASE_URL=postgresql+psycopg2://atlas:atlas@127.0.0.1:5432/atlas

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO / S3
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=atlasminio
MINIO_SECRET_KEY=atlasminio123
MINIO_BUCKET_DATA=atlas-data
MINIO_BUCKET_ICEBERG=atlas-iceberg
S3_USE_SSL=false

# Iceberg
ICEBERG_WAREHOUSE=s3://atlas-iceberg/warehouse
ICEBERG_CATALOG_URI=postgresql+psycopg2://atlas:atlas@127.0.0.1:5432/atlas

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Credential encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY

# Upload guardrails
MAX_UPLOAD_SIZE_BYTES=524288000
